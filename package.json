		"esbuild-svelte": "^0.7.3",
		"eslint": "^9.35.0",
		"eslint-plugin-obsidianmd": "^0.1.6",
		"eslint-plugin-svelte3": "^4.0.0",
		"globals": "^17.5.0",
		"obsidian": "^1.12.0",
		"svelte": "^3.55.1",
		"svelte-preprocess": "^5.0.1",
		"tslib": "2.4.0",
